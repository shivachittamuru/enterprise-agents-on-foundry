# ---------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------

PROJECT_NAME=enterprise-agents-on-foundry
ENVIRONMENT_NAME=dev
DATASET_VARIANT=adventureworks-lt

# ---------------------------------------------------------------------
# Azure subscription and deployment
# Do not place real secrets in this file.
# ---------------------------------------------------------------------

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=westus3
AZURE_RESOURCE_GROUP=

# Used for deterministic Azure resource naming.
AZURE_RESOURCE_NAME_SUFFIX=

# ---------------------------------------------------------------------
# Microsoft Foundry
# These values should be populated from azd/Bicep deployment outputs.
# ---------------------------------------------------------------------

AZURE_FOUNDRY_RESOURCE_NAME=
AZURE_FOUNDRY_PROJECT_NAME=
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_ACCOUNT_ENDPOINT=

# One inexpensive model deployment for provisioning and smoke testing.
# gpt-5.1-mini was requested but is not published in westus3. See
# docs/adr/004-model-deployment-selection.md for the catalog evidence.
# Provisioning fails with an explicit message rather than substituting a model.
AZURE_MODEL_DEPLOYMENT_NAME=chat-model
AZURE_MODEL_NAME=gpt-5.4-mini
AZURE_MODEL_VERSION=2026-03-17
AZURE_MODEL_SKU_NAME=GlobalStandard

# Thousands of tokens per minute. Azure quota is expressed in the same unit.
AZURE_MODEL_CAPACITY=10

# ---------------------------------------------------------------------
# Azure SQL
# AdventureWorksLT is the only supported dataset in the initial phase.
# Authentication should use Microsoft Entra ID where possible.
# ---------------------------------------------------------------------

AZURE_SQL_SERVER_NAME=
AZURE_SQL_SERVER_FQDN=
AZURE_SQL_DATABASE_NAME=AdventureWorksLT
AZURE_SQL_AUTHENTICATION=entra

DATABASE_CONNECT_TIMEOUT_SECONDS=30
DATABASE_QUERY_TIMEOUT_SECONDS=30
DATABASE_MAX_RESULT_ROWS=500

# Safety check used by database bootstrap scripts.
# Database scripts must refuse to run unless this exact value is true.
ALLOW_DATABASE_BOOTSTRAP=false

# ---------------------------------------------------------------------
# Monitoring
# Values should come from Bicep outputs rather than manual entry.
# ---------------------------------------------------------------------

APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_LOG_ANALYTICS_WORKSPACE_NAME=

# ---------------------------------------------------------------------
# Identity and secret storage
# Populated from deployment outputs. No secret value is stored here.
# ---------------------------------------------------------------------

AZURE_KEY_VAULT_NAME=
AZURE_MANAGED_IDENTITY_NAME=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_MANAGED_IDENTITY_PRINCIPAL_ID=

# ---------------------------------------------------------------------
# Optional future capabilities
# Disabled during v0.1.
# ---------------------------------------------------------------------

ENABLE_CONTAINER_REGISTRY=false
ENABLE_AZURE_AI_SEARCH=false
ENABLE_FOUNDRY_IQ=false
ENABLE_LONG_TERM_MEMORY=false
ENABLE_PRIVATE_NETWORKING=false
ENABLE_HOSTED_AGENT=false
ENABLE_EXTERNAL_HOSTING=false